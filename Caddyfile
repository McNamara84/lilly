:80 {
	handle /api/* {
		# With no trusted upstream configured, Caddy discards client-supplied
		# forwarding values and derives X-Forwarded-For from the socket peer.
		reverse_proxy backend:8080
	}

	handle /media/covers/* {
		root * /srv
		file_server
	}

	# User photos are private-by-default and are served only by the authorised
	# backend endpoint. Never expose arbitrary files from the shared volume.
	handle /media/* {
		respond 404
	}

	handle {
		reverse_proxy frontend:3000
	}
}
