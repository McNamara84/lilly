# Copy to /opt/lilly/shared/.env.production and set mode 0600.
# Never commit the populated file.

# Database (use URL-safe generated values)
MARIADB_ROOT_PASSWORD=CHANGE_ME
MARIADB_DATABASE=lilly
MARIADB_USER=lilly
MARIADB_PASSWORD=CHANGE_ME
DATABASE_URL=mysql://lilly:CHANGE_ME@db:3306/lilly

# Authentication
JWT_SECRET=CHANGE_ME
JWT_ACCESS_TOKEN_EXPIRY=900
JWT_REFRESH_TOKEN_EXPIRY=2592000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
PRIVACY_POLICY_VERSION=2026-03-06
ADMIN_EMAIL=

# Public origin. Use http://<SERVER_IP>:8091 only during the temporary test.
APP_BASE_URL=https://lilly.maddrax-fanclub.de
COOKIE_SECURE=true

# Mail
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@maddrax-fanclub.de

# Runtime
RUST_LOG=info
PHOTO_MAX_UPLOAD_BYTES=5242880
PHOTO_MAX_EDGE=2048
PHOTO_MAX_SOURCE_DIMENSION=10000
PHOTO_MAX_SOURCE_PIXELS=40000000
PHOTO_JPEG_QUALITY=85

# Keep disabled until the initial full imports have been reviewed.
IMPORT_SCHEDULER_ENABLED=false
IMPORT_SCHEDULE=0 10 6 * * Sat *
IMPORT_TIMEZONE=Europe/Berlin
IMPORT_SCHEDULED_ADAPTERS=maddrax,john-sinclair
