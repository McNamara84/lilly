{
	servers {
		# The host nginx proxy is the only public ingress and overwrites XFF.
		# Docker reaches Caddy through a private bridge address.
		trusted_proxies static private_ranges
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For X-Real-IP
	}
}

:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle /media/covers/* {
		root * /srv
		file_server
	}

	# Private user photos are only returned by authenticated backend routes.
	handle /media/* {
		respond 404
	}

	handle {
		reverse_proxy frontend:3000
	}
}
