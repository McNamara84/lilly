{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"packageManager": "npm@12.0.2",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test --project=chromium",
		"test:e2e:all": "playwright test --project=chromium --project=firefox --project=webkit",
		"test:e2e:mobile": "playwright test --project=mobile-chrome",
		"test:e2e:ui": "playwright test --ui --project=chromium",
		"test:lighthouse": "lhci autorun --config=./lighthouserc.cjs",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/js": "^10.0.1",
		"@lhci/cli": "^0.15.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.7",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.11.0",
		"eslint-plugin-svelte": "^3.23.0",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.12.0",
		"jsdom": "^30.1.0",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">=26.9.0",
		"npm": ">=12.0.2"
	},
	"overrides": {
		"cookie": "0.7.2"
	},
	"dependencies": {
		"@fontsource/inter": "^5.3.0",
		"@skeletonlabs/skeleton-svelte": "^5.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@tailwindcss/vite": "^4.3.3",
		"@zxcvbn-ts/core": "^4.2.0",
		"@zxcvbn-ts/language-common": "^4.1.3",
		"@zxcvbn-ts/language-de": "^4.1.1",
		"tailwindcss": "^4.3.3"
	}
}
