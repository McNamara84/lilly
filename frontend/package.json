{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"packageManager": "npm@12.2.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test --project=chromium",
		"test:e2e:all": "playwright test --project=chromium --project=firefox --project=webkit",
		"test:e2e:mobile": "playwright test --project=mobile-chrome",
		"test:e2e:ui": "playwright test --ui --project=chromium",
		"test:lighthouse": "lhci autorun --config=./lighthouserc.cjs",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@lhci/cli": "^0.15.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.8",
		"@vitest/coverage-v8": "^5.0.5",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"eslint": "^10.14.0",
		"eslint-plugin-svelte": "^3.23.1",
		"fake-indexeddb": "^6.2.7",
		"globals": "^17.13.0",
		"jsdom": "^30.1.3",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"engines": {
		"node": ">=26.13.0",
		"npm": ">=12.2.1"
	},
	"overrides": {
		"lighthouse": "13.6.0",
		"tmp": "0.2.7",
		"get-uri": {
			"basic-ftp": "6.2.4"
		},
		"@lhci/cli": {
			"uuid": "11.1.1"
		}
	},
	"dependencies": {
		"@fontsource/inter": "^5.3.0",
		"@skeletonlabs/skeleton-svelte": "^5.0.1",
		"@zxcvbn-ts/core": "^4.2.0",
		"@zxcvbn-ts/language-common": "^4.1.3",
		"@zxcvbn-ts/language-de": "^4.1.1",
		"tailwindcss": "^4.3.3"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
