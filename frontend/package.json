{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"packageManager": "npm@12.2.3",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test --project=chromium",
		"test:e2e:all": "playwright test --project=chromium --project=firefox --project=webkit",
		"test:e2e:mobile": "playwright test --project=mobile-chrome",
		"test:e2e:ui": "playwright test --ui --project=chromium",
		"test:lighthouse": "node scripts/lighthouse-run.cjs",
		"test:pwa:update": "node scripts/pwa-update-test.mjs",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@lhci/cli": "^0.16.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-node": "^6.0.5",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/package": "^3.0.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/jest-dom": "^8.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.13",
		"@vitest/coverage-v8": "^5.1.1",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"eslint": "^10.15.0",
		"eslint-plugin-svelte": "^3.24.1",
		"fake-indexeddb": "^6.2.8",
		"globals": "^17.14.0",
		"jsdom": "^31.0.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"engines": {
		"node": ">=26.13.1",
		"npm": ">=12.2.3"
	},
	"dependencies": {
		"@fontsource/inter": "^5.3.0",
		"@skeletonlabs/skeleton-svelte": "^5.0.6",
		"@zxcvbn-ts/core": "^4.3.0",
		"@zxcvbn-ts/language-common": "^4.2.0",
		"@zxcvbn-ts/language-de": "^4.1.2",
		"tailwindcss": "^4.3.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
