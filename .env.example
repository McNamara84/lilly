# Database
DATABASE_URL=mysql://lilly:CHANGE_ME@db:3306/lilly # ggignore
MARIADB_ROOT_PASSWORD=CHANGE_ME # ggignore
MARIADB_DATABASE=lilly
MARIADB_USER=lilly
MARIADB_PASSWORD=CHANGE_ME # ggignore

# Auth
JWT_SECRET=CHANGE_ME # ggignore
JWT_ACCESS_TOKEN_EXPIRY=900
JWT_REFRESH_TOKEN_EXPIRY=2592000
# Both values of a provider must be set together. Leave empty to disable it.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Increment whenever the text shown at /privacy materially changes.
PRIVACY_POLICY_VERSION=2026-03-06

# Backend
RUST_LOG=info
BACKEND_PORT=8080
# Seeds the demo admin, one active series, one issue and one collection entry.
# Set to true only for local development/testing — never in production.
ENABLE_DEMO_SEED=false
# Number of isolated test accounts to seed when ENABLE_DEMO_SEED is true.
E2E_WORKER_COUNT=0
# Replaces external wiki access with deterministic data for E2E import tests.
ENABLE_E2E_FIXTURE_ADAPTER=false

# SMTP (optional — if SMTP_HOST is not set, verification emails are logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@lilly.app

# App
APP_BASE_URL=http://localhost
COOKIE_SECURE=false
# Existing account promoted idempotently at startup; normalized and audit-logged.
ADMIN_EMAIL=
MEDIA_PATH=/media
MEDIA_URL_PREFIX=/media
# Personal issue photos (server-authoritative limits)
PHOTO_MAX_UPLOAD_BYTES=5242880
PHOTO_MAX_COUNT=4
PHOTO_MAX_EDGE=2048
PHOTO_MAX_SOURCE_DIMENSION=10000
PHOTO_MAX_SOURCE_PIXELS=40000000
PHOTO_JPEG_QUALITY=85

# Weekly full synchronization (enable only after validating both initial full imports)
IMPORT_SCHEDULER_ENABLED=false
IMPORT_SCHEDULE=0 10 6 * * Sat *
IMPORT_TIMEZONE=Europe/Berlin
IMPORT_SCHEDULED_ADAPTERS=maddrax,john-sinclair
