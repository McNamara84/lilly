# Copy to .env.acceptance.local and replace all CHANGE_ME values.
DATABASE_URL=mysql://lilly:CHANGE_ME_DB_PASSWORD@db:3306/lilly
MARIADB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MARIADB_DATABASE=lilly
MARIADB_USER=lilly
MARIADB_PASSWORD=CHANGE_ME_DB_PASSWORD
JWT_SECRET=CHANGE_ME_RANDOM_SECRET
JWT_ACCESS_TOKEN_EXPIRY=900
JWT_REFRESH_TOKEN_EXPIRY=2592000
RUST_LOG=info
BACKEND_PORT=8080
APP_BASE_URL=http://localhost:18080
COOKIE_SECURE=false
ADMIN_EMAIL=acceptance@example.test
ACCEPTANCE_PORT=18080
